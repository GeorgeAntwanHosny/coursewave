# =============================================================================
# Secrets: never commit these. Only .env.example files are allowed.
# =============================================================================
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*

# =============================================================================
# Node / Next.js (apps/web)
# =============================================================================
node_modules/
apps/web/.next/
apps/web/out/
apps/web/next-env.d.ts
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# PHP / Laravel (apps/api)
# =============================================================================
apps/api/vendor/
apps/api/bootstrap/cache/*
!apps/api/bootstrap/cache/.gitignore
apps/api/public/hot
apps/api/public/storage
apps/api/public/build
apps/api/storage/*.key
apps/api/storage/app/*
!apps/api/storage/app/.gitignore
apps/api/storage/framework/cache/*
apps/api/storage/framework/sessions/*
apps/api/storage/framework/views/*
apps/api/storage/framework/testing/*
apps/api/storage/logs/*
apps/api/storage/fonts/*
apps/api/.phpunit.cache/
apps/api/.phpunit.result.cache
apps/api/*.sqlite
apps/api/auth.json

# =============================================================================
# Docker / local data
# =============================================================================
/backups/
*.dump
*.sql.gz

# =============================================================================
# Private working notes (keep the detailed project log out of the public repo)
# =============================================================================
docs/PROJECT_STATE.internal.md
AI_SESSION_WORKFLOW.md

# =============================================================================
# Editors and OS
# =============================================================================
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini