# =============================================================================
# CourseWave — Docker environment.
# Easiest: run  .\scripts\init-env.ps1  — it creates .env and generates every secret for you.
# Never commit .env. Use only letters and digits in secrets ($ breaks docker compose).
# =============================================================================

IMAGE_TAG=latest
API_PORT=8000
WEB_PORT=3000
WS_PORT=8080
QUEUE_WORKERS=2

# ---- Public URLs: what the BROWSER uses ------------------------------------
APP_NAME=CourseWave
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000/api
PUBLIC_REVERB_HOST=localhost
PUBLIC_REVERB_PORT=8080
PUBLIC_REVERB_SCHEME=http

# ---- Secrets (generated by scripts/init-env.ps1) ---------------------------
APP_KEY=
DB_PASSWORD=
REDIS_PASSWORD=
REVERB_APP_ID=100001
REVERB_APP_KEY=
REVERB_APP_SECRET=

DB_DATABASE=coursewave
DB_USERNAME=coursewave

# ---- Stripe (init-env.ps1 copies these from apps/api/.env when present) ----
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# STRIPE_V2_API_VERSION=
# STRIPE_CONNECT_COUNTRY=
# STRIPE_CONNECT_ENTITY_TYPE=

# ---- Business rules ---------------------------------------------------------
PLATFORM_FEE_PERCENT=20
PAYOUT_MINIMUM_CENTS=1000
PAYOUT_MAX_RECONCILE_ATTEMPTS=5
REFUND_MAX_RECONCILE_ATTEMPTS=5

# ---- Notifications, live sessions, analytics -------------------------------
ADMIN_NOTIFY_NEW_SUBSCRIPTION=true
ADMIN_NOTIFY_SUBSCRIPTION_CANCELED=true
INSTRUCTOR_NOTIFY_COURSE_COMPLETED=true
LIVE_SESSION_REMINDER_MINUTES=30
LIVE_SESSION_JOIN_OPENS_MINUTES=15
ANALYTICS_CACHE_SECONDS=300
ANALYTICS_DEFAULT_DAYS=30

# ---- Production overlay only (docker-compose.prod.yml) ---------------------
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
WS_DOMAIN=ws.example.com
ACME_EMAIL=you@example.com