{
  "info": {
    "name": "Learnledger",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Student\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"Password123\",\n  \"password_confirmation\": \"Password123\",\n  \"role\": \"student\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/register",
              "host": ["{{base_url}}"],
              "path": ["api", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/me",
              "host": ["{{base_url}}"],
              "path": ["api", "me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "logout"]
            }
          }
        },
        {
          "name": "Courses",
          "item": [
            {
              "name": "List published courses",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/courses?search=",
                  "host": ["{{base_url}}"],
                  "path": ["api", "courses"],
                  "query": [{ "key": "search", "value": "" }]
                }
              }
            },
            {
              "name": "Get course by slug",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/courses/{{course_slug}}",
                  "host": ["{{base_url}}"],
                  "path": ["api", "courses", "{{course_slug}}"]
                }
              }
            }
          ]
        },
        {
          "name": "List published courses (with search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/courses?search=laravel",
              "host": ["{{base_url}}"],
              "path": ["api", "courses"],
              "query": [{ "key": "search", "value": "laravel" }]
            }
          }
        },
        {
          "name": "Billing",
          "item": [
            {
              "name": "List active plans",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/plans",
                  "host": ["{{base_url}}"],
                  "path": ["api", "plans"]
                }
              }
            },
            {
              "name": "Initiate checkout",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"plan_id\": 1\n}" },
                "url": {
                  "raw": "{{base_url}}/api/subscriptions/checkout",
                  "host": ["{{base_url}}"],
                  "path": ["api", "subscriptions", "checkout"]
                }
              }
            },
            {
              "name": "Confirm subscription",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"session_id\": \"{{stripe_session_id}}\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/subscriptions/confirm",
                  "host": ["{{base_url}}"],
                  "path": ["api", "subscriptions", "confirm"]
                }
              }
            },
            {
              "name": "My subscriptions",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/subscriptions",
                  "host": ["{{base_url}}"],
                  "path": ["api", "subscriptions"]
                }
              }
            },
            {
              "name": "Current subscription",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/subscriptions/current",
                  "host": ["{{base_url}}"],
                  "path": ["api", "subscriptions", "current"]
                }
              }
            }
          ]
        },
        {
          "name": "Learning",
          "item": [
            {
              "name": "Course learning tree",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/learning/courses/{{course_slug}}",
                  "host": ["{{base_url}}"],
                  "path": ["api", "learning", "courses", "{{course_slug}}"]
                }
              }
            },
            {
              "name": "Lesson detail",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/learning/lessons/1",
                  "host": ["{{base_url}}"],
                  "path": ["api", "learning", "lessons", "1"]
                }
              }
            },
            {
              "name": "Record progress (video heartbeat)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"watched_seconds\": 15\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/learning/lessons/1/progress",
                  "host": ["{{base_url}}"],
                  "path": ["api", "learning", "lessons", "1", "progress"]
                }
              }
            }
          ]
        },
        {
          "name": "Quiz detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/learning/quizzes/1",
              "host": ["{{base_url}}"],
              "path": ["api", "learning", "quizzes", "1"]
            }
          }
        },
        {
          "name": "Submit quiz attempt",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": {\n    \"1\": 3,\n    \"2\": 6\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/learning/quizzes/1/submit",
              "host": ["{{base_url}}"],
              "path": ["api", "learning", "quizzes", "1", "submit"]
            }
          }
        },
        {
          "name": "Quiz attempt history",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/learning/quizzes/1/attempts",
              "host": ["{{base_url}}"],
              "path": ["api", "learning", "quizzes", "1", "attempts"]
            }
          }
        },
        {
          "name": "Cancel current subscription (refunds unused days)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/subscriptions/current/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "subscriptions", "current", "cancel"]
            },
            "description": "Cancels the active subscription, voids not-yet-elapsed days and queues a refund for them. The 'Current subscription' request now also returns refundable_cents / refundable_human."
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" }
  ]
}
