{
  "info": {
    "name": "CourseWave",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Student\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"Password123\",\n  \"password_confirmation\": \"Password123\",\n  \"role\": \"student\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/register",
              "host": ["{{base_url}}"],
              "path": ["api", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/me",
              "host": ["{{base_url}}"],
              "path": ["api", "me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "logout"]
            }
          }
        },
        {
          "name": "Courses",
          "item": [
            {
              "name": "List published courses",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/courses?search=",
                  "host": ["{{base_url}}"],
                  "path": ["api", "courses"],
                  "query": [{ "key": "search", "value": "" }]
                }
              }
            },
            {
              "name": "Get course by slug",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/courses/{{course_slug}}",
                  "host": ["{{base_url}}"],
                  "path": ["api", "courses", "{{course_slug}}"]
                }
              }
            }
          ]
        },
        {
          "name": "List published courses (with search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/courses?search=laravel",
              "host": ["{{base_url}}"],
              "path": ["api", "courses"],
              "query": [{ "key": "search", "value": "laravel" }]
            }
          }
        },
        {
          "name": "Billing",
          "item": [
            {
              "name": "List active plans",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/plans",
                  "host": ["{{base_url}}"],
                  "path": ["api", "plans"]
                }
              }
            },
            {
              "name": "Initiate checkout",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"plan_id\": 1\n}" },
                "url": {
                  "raw": "{{base_url}}/api/subscriptions/checkout",
                  "host": ["{{base_url}}"],
                  "path": ["api", "subscriptions", "checkout"]
                }
              }
            },
            {
              "name": "Confirm subscription",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"session_id\": \"{{stripe_session_id}}\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/subscriptions/confirm",
                  "host": ["{{base_url}}"],
                  "path": ["api", "subscriptions", "confirm"]
                }
              }
            },
            {
              "name": "My subscriptions",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/subscriptions",
                  "host": ["{{base_url}}"],
                  "path": ["api", "subscriptions"]
                }
              }
            },
            {
              "name": "Current subscription",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/subscriptions/current",
                  "host": ["{{base_url}}"],
                  "path": ["api", "subscriptions", "current"]
                }
              }
            }
          ]
        },
        {
          "name": "Learning",
          "item": [
            {
              "name": "Course learning tree",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/learning/courses/{{course_slug}}",
                  "host": ["{{base_url}}"],
                  "path": ["api", "learning", "courses", "{{course_slug}}"]
                }
              }
            },
            {
              "name": "Lesson detail",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/learning/lessons/1",
                  "host": ["{{base_url}}"],
                  "path": ["api", "learning", "lessons", "1"]
                }
              }
            },
            {
              "name": "Record progress (video heartbeat)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"watched_seconds\": 15\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/learning/lessons/1/progress",
                  "host": ["{{base_url}}"],
                  "path": ["api", "learning", "lessons", "1", "progress"]
                }
              }
            }
          ]
        },
        {
          "name": "Quiz detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/learning/quizzes/1",
              "host": ["{{base_url}}"],
              "path": ["api", "learning", "quizzes", "1"]
            }
          }
        },
        {
          "name": "Submit quiz attempt",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": {\n    \"1\": 3,\n    \"2\": 6\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/learning/quizzes/1/submit",
              "host": ["{{base_url}}"],
              "path": ["api", "learning", "quizzes", "1", "submit"]
            }
          }
        },
        {
          "name": "Quiz attempt history",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/learning/quizzes/1/attempts",
              "host": ["{{base_url}}"],
              "path": ["api", "learning", "quizzes", "1", "attempts"]
            }
          }
        },
        {
          "name": "Cancel current subscription (refunds unused days)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/subscriptions/current/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "subscriptions", "current", "cancel"]
            },
            "description": "Cancels the active subscription, voids not-yet-elapsed days and queues a refund for them. The 'Current subscription' request now also returns refundable_cents / refundable_human."
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "List lesson comments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/learning/lessons/1/comments?page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "learning", "lessons", "1", "comments"],
              "query": [{ "key": "page", "value": "1" }]
            }
          }
        },
        {
          "name": "Post comment (omit parent_id) or reply (set parent_id)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Great lesson!\",\n  \"parent_id\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/learning/lessons/1/comments",
              "host": ["{{base_url}}"],
              "path": ["api", "learning", "lessons", "1", "comments"]
            }
          }
        },
        {
          "name": "Edit own comment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Edited text\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/learning/comments/1",
              "host": ["{{base_url}}"],
              "path": ["api", "learning", "comments", "1"]
            }
          }
        },
        {
          "name": "Delete comment (author / course instructor / admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/learning/comments/1",
              "host": ["{{base_url}}"],
              "path": ["api", "learning", "comments", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Certificates",
      "item": [
        {
          "name": "My certificates",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/certificates",
              "host": ["{{base_url}}"],
              "path": ["api", "certificates"]
            }
          }
        },
        {
          "name": "Download certificate PDF",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/certificates/1/download",
              "host": ["{{base_url}}"],
              "path": ["api", "certificates", "1", "download"]
            },
            "description": "Returns the PDF, or 409 while it is still being generated. Use Send and Download in Postman."
          }
        },
        {
          "name": "Verify certificate (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/certificates/verify/CW-AAAA-BBBB-CCCC",
              "host": ["{{base_url}}"],
              "path": ["api", "certificates", "verify", "CW-AAAA-BBBB-CCCC"]
            }
          }
        }
      ]
    },
    {
      "name": "Dev tools (local only)",
      "item": [
        {
          "name": "Complete 2 courses + issue certificates",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"count\": 2,\n  \"generate_pdf\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/dev/complete-courses",
              "host": ["{{base_url}}"],
              "path": ["api", "dev", "complete-courses"]
            },
            "description": "Student token required. Only exists when APP_ENV is local or testing. generate_pdf=true renders the PDF immediately so no queue worker is needed."
          }
        },
        {
          "name": "Reset my certificates + lesson progress",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/dev/reset-learning",
              "host": ["{{base_url}}"],
              "path": ["api", "dev", "reset-learning"]
            }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List notifications (add ?unread=1 for unread only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/notifications?page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "notifications"],
              "query": [{ "key": "page", "value": "1" }]
            }
          }
        },
        {
          "name": "Unread count",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/notifications/unread-count",
              "host": ["{{base_url}}"],
              "path": ["api", "notifications", "unread-count"]
            }
          }
        },
        {
          "name": "Mark one as read",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/notifications/{{notification_id}}/read",
              "host": ["{{base_url}}"],
              "path": ["api", "notifications", "{{notification_id}}", "read"]
            }
          }
        },
        {
          "name": "Mark all as read",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/notifications/read-all",
              "host": ["{{base_url}}"],
              "path": ["api", "notifications", "read-all"]
            }
          }
        },
        {
          "name": "Broadcast channel auth (what Echo calls)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "socket_id", "value": "1234.5678" },
                {
                  "key": "channel_name",
                  "value": "private-App.Models.User.{{user_id}}"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/broadcasting/auth",
              "host": ["{{base_url}}"],
              "path": ["api", "broadcasting", "auth"]
            },
            "description": "Expect 200 with an { auth: ... } signature for your own user id, and 403 for someone else's. Add notification_id and user_id to the collection variables."
          }
        }
      ]
    },
    {
      "name": "Live sessions",
      "item": [
        {
          "name": "My live sessions (courses I have started)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/learning/live-sessions",
              "host": ["{{base_url}}"],
              "path": ["api", "learning", "live-sessions"]
            },
            "description": "Upcoming and live sessions only. join_url is null until 15 minutes before the start, and always null for non-https links."
          }
        },
        {
          "name": "Live sessions for one course",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/learning/courses/{{course_slug}}/live-sessions",
              "host": ["{{base_url}}"],
              "path": [
                "api",
                "learning",
                "courses",
                "{{course_slug}}",
                "live-sessions"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" }
  ]
}
